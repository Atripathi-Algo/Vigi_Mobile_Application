# VIGIL runtime configuration.
# Copy to `.env` (cp .env.example .env), fill in what you need, then rebuild.
# Everything is optional: with no keys the app runs fully on-device.
# NOTE: .env is bundled into the APK, so it is readable by anyone with the APK.
# Never put production secrets here; use a backend proxy for those.

# --- Optional VIGIL backend (leave blank for on-device only) ---
VIGIL_API_BASE_URL=
VIGIL_API_KEY=

# --- Google Calendar ---
# Private calendars: link Google accounts in the app (Loadout > Google accounts). Nothing goes in this file.
# API key for reading a PUBLIC calendar (optional)
GOOGLE_CALENDAR_API_KEY=
# Full calendar id (e.g. you@gmail.com). An API key cannot resolve "primary".
GOOGLE_CALENDAR_ID=

# --- Weather (Open-Meteo needs no key) ---
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=28.6139
WEATHER_LONGITUDE=77.2090

# --- Cloud AI for VIGIL Uplink (optional, off unless a key is set) ---
# gemini (free tier) | openai (Groq, OpenRouter, Ollama, OpenAI) | anthropic (paid)
CLOUD_AI_PROVIDER=gemini
CLOUD_AI_API_KEY=
# Leave model/base URL blank to use the provider's default (gemini: gemini-flash-latest).
# openai-compatible: set both. Groq base https://api.groq.com/openai, OpenRouter https://openrouter.ai/api
CLOUD_AI_MODEL=
CLOUD_AI_BASE_URL=

# --- Firebase Cloud Messaging (push notifications; optional) ---
# Firebase console > Project settings > Your apps > Android app (package com.algoanalytics.vigil).
# No google-services.json is needed; these values are passed to Firebase at runtime.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
